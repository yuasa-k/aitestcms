{
  "name": "ai-cms-test",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --open",
    "build": "astro build",
    "build:preview": "BUILD_MODE=preview astro build",
    "preview": "astro preview",
    "check": "astro check",
    "media:dummy": "node scripts/generate-dummy-media.mjs",
    "media:video": "node scripts/compress-video.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:build": "vitest run --project build",
    "test:watch": "vitest --project unit",
    "verify:dist": "node scripts/verify-dist.mjs",
    "deploy:dry-run": "npm run build && node scripts/verify-dist.mjs production && wrangler deploy --dry-run",
    "astro": "astro"
  },
  "volta": {
    "node": "22.23.5"
  },
  "dependencies": {
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.5",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  }
}
