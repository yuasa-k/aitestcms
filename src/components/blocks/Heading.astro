---
interface Props {
  text: string;
  level: 2 | 3;
}

const { text, level } = Astro.props;
const Tag = level === 3 ? 'h3' : 'h2';
---

<div class="heading">
  <Tag class:list={['heading__text', `heading__text--h${level}`]}>{text}</Tag>
</div>

<style>
  .heading {
    max-width: var(--content-width);
    margin-inline: auto;
    padding: var(--space-5) var(--gutter) var(--space-2);
  }
  .heading__text {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1.5;
  }
  .heading__text--h2 {
    font-size: var(--text-xl);
  }
  .heading__text--h3 {
    font-size: var(--text-lg);
  }
</style>
