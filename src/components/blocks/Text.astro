---
interface Props {
  paragraphs: string[];
}

const { paragraphs } = Astro.props;
---

<div class="text">
  {paragraphs.map((p) => <p>{p}</p>)}
</div>

<style>
  .text {
    max-width: var(--content-width);
    margin-inline: auto;
    padding: var(--space-2) var(--gutter);
    color: var(--color-text-muted);
  }
  p {
    margin: 0 0 var(--space-3);
    white-space: pre-line;
  }
  p:last-child {
    margin-bottom: 0;
  }
</style>
