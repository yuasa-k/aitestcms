---
// ヒーロー。画面いっぱいのポスター画像の上に、背景動画（任意）と見出しを重ねる。
// ポスター画像はページで最初に見える大きな画像なので、遅延読み込みせず優先して読み込む。
import { Picture } from 'astro:assets';
import { issueVideoUrl, loadIssueImage, responsiveWidths } from '../../lib/media';
import BackgroundVideo from '../media/BackgroundVideo.astro';
import VideoToggle from '../media/VideoToggle.astro';

interface Props {
  issueId: string;
  video?: string;
  poster: string;
  posterAlt: string;
  title: string;
  subtitle?: string;
}

const { issueId, video, poster, posterAlt, title, subtitle } = Astro.props;
const posterImage = await loadIssueImage(issueId, poster);
---

<section class="hero" data-lazy-video={video ? '' : undefined}>
  <div class="hero__media">
    <Picture
      src={posterImage}
      alt={posterAlt}
      formats={['avif', 'webp']}
      widths={responsiveWidths([640, 960, 1280, 1920], posterImage.width)}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero__poster"
    />
    {video && <BackgroundVideo src={issueVideoUrl(issueId, video)} />}
  </div>
  <div class="hero__content">
    {subtitle && <p class="hero__subtitle">{subtitle}</p>}
    <h1 class="hero__title">{title}</h1>
  </div>
  <div class="hero__scroll" aria-hidden="true">
    <span>Scroll</span>
  </div>
  {video && <VideoToggle />}
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero__media :global(.hero__poster) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* 文字を読みやすくするための影 */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, transparent 40%, var(--color-overlay) 75%, var(--color-bg));
  }
  .hero__content {
    padding: 0 var(--gutter) calc(var(--space-6) + var(--space-3));
    text-align: center;
    animation: hero-in var(--duration-slow) var(--ease-out) both;
  }
  .hero__subtitle {
    margin: 0 0 var(--space-2);
    color: var(--color-accent);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  .hero__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-hero);
    font-weight: 400;
    letter-spacing: 0.12em;
    line-height: 1.3;
  }
  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: var(--space-3);
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    color: var(--color-text-muted);
    font-size: 0.625rem;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    transform: translateX(-50%);
  }
  .hero__scroll::after {
    content: '';
    width: 1px;
    height: 2.5rem;
    background: linear-gradient(var(--color-text), transparent);
    transform-origin: top;
    animation: scroll-line 2.4s var(--ease-out) infinite;
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translate3d(0, 1.5rem, 0);
    }
  }
  @keyframes scroll-line {
    0% {
      transform: scaleY(0);
    }
    50% {
      transform: scaleY(1);
    }
    100% {
      transform: scaleY(1);
      opacity: 0;
    }
  }
</style>
