---
import '../styles/global.css';
import { site } from '../site.config';
import { isPreview } from '../lib/build-mode';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const preview = isPreview();
const fullTitle = `${title} | ${site.brandName}`;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{preview ? `[プレビュー] ${fullTitle}` : fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {preview && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    {
      preview && (
        <div class="preview-banner" role="note">
          プレビュー：公開日時前の号も表示しています
        </div>
      )
    }
    <header class="site-header">
      <a href="/" class="brand">{site.brandName}</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <small>&copy; {site.brandName}（架空のブランドによるデモサイトです）</small>
    </footer>
  </body>
</html>

<style>
  .preview-banner {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: var(--space-1) var(--gutter);
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-size: var(--text-xs);
    text-align: center;
  }
  .site-header {
    position: absolute;
    inset-inline: 0;
    z-index: 10;
    padding: var(--space-2) var(--gutter);
    text-align: center;
  }
  .preview-banner + .site-header {
    top: 2.25rem;
  }
  .brand {
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-decoration: none;
  }
  .site-footer {
    padding: var(--space-5) var(--gutter) var(--space-4);
    border-top: 1px solid var(--color-line);
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
